{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/math-concept-graph.schema.json",
  "title": "Mathematical Concept Graph",
  "description": "A node/edge graph for mathematical definitions, results, examples, and dependencies extracted from notes or textbooks.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "generatedAt", "source", "counts"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generator": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["path", "format"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "format": {
              "type": "string",
              "enum": [
                "pdftotext-layout",
                "plain-text",
                "markdown",
                "latex",
                "unknown"
              ]
            }
          }
        },
        "counts": {
          "type": "object",
          "required": ["nodes", "edges"],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "properties": {
            "nodes": { "type": "integer", "minimum": 0 },
            "edges": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^(definition|theorem|lemma|example|proposition|corollary|concept|remark|axiom):[0-9A-Z]+\\.[0-9]+:[a-z0-9][a-z0-9-]*$"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "number",
        "title",
        "domain",
        "chapter",
        "topicCluster",
        "text",
        "dependencies",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "kind": {
          "type": "string",
          "enum": [
            "definition",
            "theorem",
            "lemma",
            "example",
            "proposition",
            "corollary",
            "concept",
            "remark",
            "axiom"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "number": {
          "type": "string",
          "pattern": "^[0-9A-Z]+\\.[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "chapter": {
          "type": "object",
          "required": ["id", "title"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string" }
          }
        },
        "topicCluster": { "type": "string" },
        "text": {
          "type": "object",
          "required": ["raw", "statement", "proof"],
          "additionalProperties": false,
          "properties": {
            "raw": { "type": "string", "minLength": 1 },
            "statement": { "type": "string" },
            "proof": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            }
          }
        },
        "dependencies": {
          "type": "object",
          "required": ["statement", "proof"],
          "additionalProperties": false,
          "properties": {
            "statement": {
              "type": "array",
              "items": { "$ref": "#/$defs/nodeId" },
              "uniqueItems": true
            },
            "proof": {
              "type": "array",
              "items": { "$ref": "#/$defs/nodeId" },
              "uniqueItems": true
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "label",
        "directed",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^edge:[a-z_]+:[a-z0-9-]+:[a-z0-9-]+$"
        },
        "source": {
          "description": "The concept/result being referenced. For dependency edges, this is the prerequisite or supporting result.",
          "$ref": "#/$defs/nodeId"
        },
        "target": {
          "description": "The concept/result that depends on or uses the source.",
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "type": "string",
          "enum": [
            "statement_dependency",
            "proof_dependency",
            "requires",
            "generalizes",
            "specializes",
            "implies",
            "equivalent_to",
            "uses",
            "is_example_of",
            "is_counterexample_to",
            "motivates",
            "analogous_to",
            "dual_to"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "directed": { "type": "boolean" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "minItems": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["method", "referenceNumber", "matchedText", "confidence"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "explicit_reference",
            "parenthetical_reference",
            "by_reference",
            "previous_reference"
          ]
        },
        "referenceNumber": {
          "type": "string",
          "pattern": "^[0-9A-Z]+\\.[0-9]+$"
        },
        "matchedText": { "type": "string" },
        "context": { "type": "string" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
